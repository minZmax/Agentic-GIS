# ─────────────────────────────────────────────
# Agentic-GIS 환경 변수 설정
# ─────────────────────────────────────────────
# 이 파일을 복사하여 .env 파일로 만든 후 값을 채워주세요.
#   cp .env.example .env
# ─────────────────────────────────────────────

# PostgreSQL / PostGIS 설정 (기본값으로 Docker 컨테이너 내 DB 연결)
DB_HOST=db
DB_PORT=5432
DB_NAME=goyang
DB_USER=postgres
DB_PASSWORD=1234
# Docker 컨테이너 DB를 호스트(DBeaver 등)에서 접속할 포트 (로컬 PG와 충돌 방지용)
HOST_DB_PORT=5433

# Gemini API Key (챗봇 AI 기능에 필수)
# https://aistudio.google.com/apikey 에서 발급받을 수 있습니다.
GEMINI_API_KEY=여기에_본인의_API_KEY를_입력하세요
GEMINI_MODEL=gemini-3.1-flash-lite
